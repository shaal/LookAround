{
  "name": "parallax-3d-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local GLB playground controlled by head pose and experimental eye direction.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5174 --strictPort",
    "test": "tsx --test src/*.test.ts",
    "setup": "node scripts/setup-assets.mjs",
    "postinstall": "npm run setup"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.187.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
